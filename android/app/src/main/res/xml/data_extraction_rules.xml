<?xml version="1.0" encoding="utf-8"?>
<!-- r723：Android 12+ 的"云备份 / 设备迁移"规则 —— 两条都排除全部数据。
     与 `android:allowBackup="false"` 同源：不要把 NAS 客户端的数据搬出本机。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
