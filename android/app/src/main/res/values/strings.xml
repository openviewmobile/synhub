    <string name="widget_action_attach">New with attachment</string>
    <string name="widget_notebooks_label">Notebooks</string>
    <string name="widget_todos_label">To-dos</string>
    <string name="widget_new_note_label">New note</string>
    <string name="widget_new_note_hint">Tap to write</string>
    <string name="widget_notebook_pick">Choose a notebook</string>
    <string name="widget_notebook_all">All notes</string>
    <string name="widget_notebook_save_failed">Could not save the selection</string>
    <string name="widget_notebook_count">%1$d notes</string>
    <string name="widget_placeholder_not_logged_in">Open the app and sign in to see this here</string>
    <string name="widget_placeholder_not_connected">Not connected to the NAS yet; connect to see this here</string>
    <string name="widget_placeholder_no_photos">No photos yet</string>
    <string name="widget_placeholder_no_notes">No notes yet — tap to create one</string>
    <string name="widget_placeholder_no_notebooks">No notebooks yet</string>
    <string name="widget_placeholder_no_todos">No open to-dos</string>
    <string name="widget_updated_prefix">Updated %1$s</string>
    <string name="widget_due_prefix">Due %1$s</string>
    <string name="widget_encrypted_marker">Encrypted</string>
    <string name="widget_untitled_note">Untitled note</string>
    <string name="widget_untitled_notebook">Untitled notebook</string>
    <string name="widget_untitled_todo">Untitled to-do</string>
    <!-- 第 41 轮：原生可见文案（通知/前台服务）——英文默认，App 内语言决定用哪份 -->
    <string name="chat_reply_hint">Reply…</string>
    <string name="chat_connecting_foreground">Keeping connection…</string>
    <string name="chat_reconnecting_foreground">Reconnecting…</string>
