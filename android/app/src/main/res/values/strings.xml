    <string name="photo_backup_failed_fmt">Failed: %1$s</string>
    <!-- r341 D42：通知渠道名/描述 —— 必须**走 AppLang.s**（App 内语言），
         不许硬编码中文（英文界面会显示中文）也不许 `context.getString`（跟随系统语言）。
         渠道名在系统「应用 → 通知」里对用户可见。 -->
    <string name="chat_service_channel">Background connection</string>
    <string name="chat_service_channel_desc">Keeps a persistent connection to Chat Server</string>
