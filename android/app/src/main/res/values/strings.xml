<?xml version="1.0" encoding="utf-8"?>
<!--
  应用名（桌面上显示的那个）。默认 values/ 放英文，values-zh/ 放中文：
  非中文系统locale 落到 SynHub，中文系统落到「星枢」。
  应用内语言切换只影响界面文案；桌面名跟**系统语言**走，这是 Android 的惯例。
-->
<resources>
    <string name="app_name">SynHub</string>
    <!-- 待办提醒（Android 平台批 A）：系统通知渠道 dsnote 的名字与正文 -->
    <string name="note_reminder_channel">To-do reminders</string>
    <string name="note_due_prefix">Due %1$s</string>
    <string name="note_overdue_title">Overdue to-dos</string>
    <string name="note_overdue_count">%1$d unfinished to-do(s) are overdue</string>
    <!-- 相册「手机自动备份」：系统通知渠道 + 前台服务通知标题
         （官方 Synology Photos 的 str_noti_channel_photo_backup = "Backup process"） -->
    <string name="photo_backup_channel_name">Backup process</string>
    <string name="photo_backup_notification_title">Photo Backup</string>
    <!-- 主屏小组件（P66 相册 / N1 笔记）：组件名 + 占位文案 + 行内文案。
         小组件文案走**原生资源**（不是 ARB）：RemoteViews 由 launcher 进程
         渲染，跟系统语言走，和"应用内语言切换"是两套系统（桌面名 app_name 同理）。 -->
    <string name="widget_photos_label">Photos</string>
    <string name="widget_notes_label">Notes</string>
    <string name="widget_quickstart_label">Quickstart</string>
    <string name="widget_action_camera">New from camera</string>
